# Copy this file to `.env` and adjust if you need to. `.env` is gitignored, this file is not.
# The defaults below work as-is for local development.

POSTGRES_USER=burnout
POSTGRES_PASSWORD=burnout_local_dev
POSTGRES_DB=burnout
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Where the raw dataset lives. Relative paths are resolved from the repo root.
RAW_DATA_PATH=data/raw/synthetic-employee-dataset.json
